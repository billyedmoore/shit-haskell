cabal-version:      2.4
name:               multi
version:            0.2.1
build-type:         Simple

library
    exposed-modules:  Multi.Shapes, Multi.Report
    other-modules:    Multi.Internal, Paths_multi
    autogen-modules:  Paths_multi
    hs-source-dirs:   src
    build-depends:    base >=4 && <5
    default-language: Haskell2010
    default-extensions: LambdaCase, TupleSections
    cpp-options:      -DMULTI_FEATURE=3

executable multi
    main-is:          Main.hs
    hs-source-dirs:   app
    build-depends:    base, multi
    default-language: Haskell2010
    ghc-options:      -Wall

test-suite spec
    type:             exitcode-stdio-1.0
    main-is:          Spec.hs
    hs-source-dirs:   test
    build-depends:    base, multi
    default-language: Haskell2010
